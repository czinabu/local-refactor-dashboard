# Copy to .env and adjust. All values are optional.

# Base URL of your Ollama server (no path). Use your Tailscale/LAN IP if Ollama runs on another machine.
OLLAMA_BASE_URL=http://localhost:11434

# Model used for refactoring.
OLLAMA_MODEL=qwen3:14b

# Seconds to wait for Ollama (for streaming, the longest allowed gap between tokens).
OLLAMA_TIMEOUT=60
